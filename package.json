    "test:user": "tsc && jest --runInBand --detectOpenHandles --forceExit src/tests/user.test.ts",
    "test:auth": "tsc && jest --runInBand --detectOpenHandles --forceExit src/tests/auth.test.ts",
    "test:chat": "tsc && jest --runInBand --detectOpenHandles --forceExit src/tests/chat.test.ts",
    "test:health": "tsc && jest --runInBand --detectOpenHandles --forceExit src/tests/health.test.ts",
