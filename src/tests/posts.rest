# Get all posts
GET http://localhost:3000/posts
Content-Type: application/json
Cookie: accessToken=<token>


###
# Get a post by id
GET http://localhost:3000/posts/693d6f4cf91d8fc96c6a3cf9
Content-Type: application/json
Cookie: accessToken=<token>


###
# Get posts by author
GET http://localhost:3000/posts?authorId=693d6e2f3ce1b793c84003cf
Content-Type: application/json
Cookie: accessToken=<token>


###
# Add a new post
POST http://localhost:3000/posts
Content-Type: application/json
Cookie: accessToken=<token>

{
  "title": "Hello World",
  "content": "This is a test post",
  "type": "Other",
  "authorId": "693d6e2f3ce1b793c84003cf"
}


###
# Update a post
PUT http://localhost:3000/posts/693d6f4cf91d8fc96c6a3cf9
Content-Type: application/json
Cookie: accessToken=<token>

{
  "title": "Hello World",
  "content": "This is an updated test post",
  "type": "Donation",
  "authorId": "693d6e2f3ce1b793c84003cf"
}


###
# Like a post
POST http://localhost:3000/posts/693d6f4cf91d8fc96c6a3cf9/like
Content-Type: application/json
Cookie: accessToken=<token>


###
# Unlike a post
POST http://localhost:3000/posts/693d6f4cf91d8fc96c6a3cf9/unlike
Content-Type: application/json
Cookie: accessToken=<token>