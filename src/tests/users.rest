# Get all users
GET http://localhost:3000/users
Accept: application/json

###

# Get a user by id
GET http://localhost:3000/users/69590f00d8cfe5f37f38ca02
 
###

# Get users by author
GET http://localhost:3000/users?username=eden0501
Accept: application/json

###

# Add a new user
POST http://localhost:3000/users
Content-Type: application/json

{
  "username": "eden0501",
