# Get all users
GET http://localhost:3000/users
Content-Type: application/json
Cookie: accessToken=<token>


###
# Get a user by id
GET http://localhost:3000/users/69590f00d8cfe5f37f38ca02
Content-Type: application/json
Cookie: accessToken=<token>


###
# Get users by username
GET http://localhost:3000/users?username=eden0501
Content-Type: application/json
Cookie: accessToken=<token>


###
# Update a user
PUT http://localhost:3000/users/69590f00d8cfe5f37f38ca02
Content-Type: application/json
Cookie: accessToken=<token>

